{
  "name": "tiantian-jizhang",
  "productName": "天天记账",
  "version": "0.3.0",
  "description": "天天记账 —— 个人记账工具（Windows / Mac）",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "dist": "electron-builder"
  },
  "keywords": [
    "记账",
    "bookkeeping",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "build": {
    "appId": "com.tiantian.jizhang",
    "productName": "天天记账",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "main/**/*",
      "db/**/*",
      "preload.js",
      "score.js",
      "src/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "天天记账"
    }
  }
}
